STIL 1.0;

// Synthetic STIL sample for STIL Optimizer testing. Not from a real design.
// Case 7: chip_reset macro called every 4 patterns inside the pattern list.

Header {
   Title "soc_x resets between patterns";
   Date "Fri Oct 23 2026";
   Source "STIL Optimizer synthetic sample set";
}

Signals {
   "RST_N" In; "CLK" In; "SE" In; "TM" In;
   "TCK" In; "TMS" In; "TDI" In; "TDO" Out;
   "REFCLK" In; "PLL_LOCK" Out;
   "SI1" In { ScanIn; }
   "SI2" In { ScanIn; }
   "SI3" In { ScanIn; }
   "SI4" In { ScanIn; }
   "SO1" Out { ScanOut; }
   "SO2" Out { ScanOut; }
   "SO3" Out { ScanOut; }
   "SO4" Out { ScanOut; }
   "D0" In; "D1" In; "D2" In; "D3" In; "D4" In; "D5" In; "D6" In; "D7" In;
   "Q0" Out; "Q1" Out; "Q2" Out; "Q3" Out; "Q4" Out; "Q5" Out;
}

SignalGroups {
   "_pi" = '"D0"+"D1"+"D2"+"D3"+"D4"+"D5"+"D6"+"D7"';
   "_po" = '"Q0"+"Q1"+"Q2"+"Q3"+"Q4"+"Q5"';
   "all_si" = '"SI1"+"SI2"+"SI3"+"SI4"';
   "all_so" = '"SO1"+"SO2"+"SO3"+"SO4"';
}

ScanStructures {
   ScanChain "chain1" { ScanLength 64; ScanIn "SI1"; ScanOut "SO1"; }
   ScanChain "chain2" { ScanLength 64; ScanIn "SI2"; ScanOut "SO2"; }
   ScanChain "chain3" { ScanLength 64; ScanIn "SI3"; ScanOut "SO3"; }
   ScanChain "chain4" { ScanLength 64; ScanIn "SI4"; ScanOut "SO4"; }
}

Timing {
   WaveformTable "_default_WFT_" {
      Period '100ns';
      Waveforms {
         "RST_N" { 01 { '0ns' D/U; } }
         "SE" { 01 { '0ns' D/U; } }
         "TM" { 01 { '0ns' D/U; } }
         "TMS" { 01 { '0ns' D/U; } }
         "TDI" { 01 { '0ns' D/U; } }
         "_pi" { 01 { '0ns' D/U; } }
         "all_si" { 01 { '0ns' D/U; } }
         "CLK" { 01P { '0ns' D/U/D; '45ns' D/U/U; '55ns' D/U/D; } }
         "TCK" { 01P { '0ns' D/U/D; '45ns' D/U/U; '55ns' D/U/D; } }
         "REFCLK" { 01P { '0ns' D/U/D; '25ns' D/U/U; '75ns' D/U/D; } }
         "_po" { LHX { '0ns' Z; '90ns' L/H/X; } }
         "all_so" { LHX { '0ns' Z; '90ns' L/H/X; } }
         "TDO" { LHX { '0ns' Z; '90ns' L/H/X; } }
         "PLL_LOCK" { LHX { '0ns' Z; '90ns' L/H/X; } }
      }
   }
}

PatternBurst "case7_resets_between_burst" {
   PatList { "case7_resets_between_patterns"; }
}

PatternExec {
   PatternBurst "case7_resets_between_burst";
}

Procedures {
   "load_unload" {
      W "_default_WFT_";
      V { "CLK"=0; "SE"=1; }
      Shift { V { "SI1"=#; "SI2"=#; "SI3"=#; "SI4"=#; "SO1"=#; "SO2"=#; "SO3"=#; "SO4"=#; "CLK"=P; } }
      V { "SE"=0; }
   }
   "capture" {
      W "_default_WFT_";
      V { "_pi"=#; }
      V { "_po"=#; }
      V { "CLK"=P; }
   }
   "ijtag_write" {
      W "_default_WFT_";
      V { "TMS"=1; "TCK"=P; }
      V { "TMS"=0; }
      Shift { V { "TDI"=#; "TCK"=P; } }
      V { "TMS"=1; "TCK"=0; }
   }
}

MacroDefs {
   "test_setup" {
      W "_default_WFT_";
      C { "RST_N"=1; "SE"=0; "TM"=1; "CLK"=0; "TCK"=0; "TMS"=0; "TDI"=0; "REFCLK"=0; "_pi"=00000000; "all_si"=0000; }
      V { "RST_N"=0; "TMS"=1; }
      Loop 31 { V { "RST_N"=0; } }        // reset hold
      V { "RST_N"=1; }
      Loop 5 { V { "TCK"=P; "TMS"=1; } }  // TAP to Test-Logic-Reset
      V { "TCK"=P; "TMS"=0; }
      V { "TCK"=0; }
      Call "ijtag_write" { "TDI"=1011000110101100101; }   // PLL config TDR
      Call "ijtag_write" { "TDI"=0110011100010110011; }   // clock mux TDR
      V { "TCK"=0; "TMS"=0; }
      V { "REFCLK"=P; }
      Loop 2500 { V { "REFCLK"=P; } }     // PLL lock wait
      V { "REFCLK"=0; }
   }
   "chip_reset" {
      W "_default_WFT_";
      V { "RST_N"=0; }
      Loop 31 { V { "RST_N"=0; } }
      V { "RST_N"=1; }
   }
}

