   "precondition all Signals": Macro "test_setup";
   "pattern 0": Call "load_unload" {
      "SO1"=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX;
